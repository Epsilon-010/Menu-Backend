# Copy to .env and adjust. Never commit .env.

# --- Postgres container (docker compose) ---
POSTGRES_USER=menu
POSTGRES_PASSWORD=menu
POSTGRES_DB=menu

# --- Host ports published by docker compose (change them if they clash locally) ---
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8020
FRONTEND_HOST_PORT=5173

# --- Backend settings ---
APP_NAME=Menu SaaS API
ENVIRONMENT=development
# Used when running the API or tests on the host (uv run ...). Inside docker compose,
# DATABASE_URL and REDIS_URL are overridden to point at the postgres/redis services.
# Tests derive their own resources from these: database "<name>_test" and Redis db 15.
DATABASE_URL=postgresql+asyncpg://menu:menu@localhost:5440/menu
REDIS_URL=redis://localhost:6380/0
