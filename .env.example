# Copy to .env and adjust. Never commit .env.

# --- Postgres container (docker compose) ---
POSTGRES_USER=menu
POSTGRES_PASSWORD=menu
POSTGRES_DB=menu

# --- Host ports published by docker compose (change them if they clash locally) ---
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8020
FRONTEND_HOST_PORT=5173

# --- Backend settings ---
APP_NAME=Menu SaaS API
ENVIRONMENT=development
# Used when running the API or tests on the host (uv run ...). Inside docker compose,
# DATABASE_URL and REDIS_URL are overridden to point at the postgres/redis services.
# Tests derive their own resources from these: database "<name>_test" and Redis db 15.
DATABASE_URL=postgresql+asyncpg://menu:menu@localhost:5440/menu
REDIS_URL=redis://localhost:6380/0

# --- Auth ---
# Access token signing key (HS256), at least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# Keep true: browsers accept Secure cookies on http://localhost. Set false only for other plain-HTTP hosts.
AUTH_COOKIE_SECURE=true
# Login attempts allowed per account (user) per window before a temporary block, from any IP.
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_ACCOUNT=5

# --- Images (Cloudinary) ---
# Dashboard > Settings > API Keys. Leave empty to run without image uploads (the API answers 503
# on the upload signature). The secret only signs uploads on the backend; it never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
