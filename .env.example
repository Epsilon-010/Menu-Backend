# Copy to .env and adjust. Never commit .env.

# --- Postgres container (docker compose) ---
POSTGRES_USER=menu
POSTGRES_PASSWORD=menu
POSTGRES_DB=menu

# --- Host ports published by docker compose (change them if they clash locally) ---
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6380
# Postgres, Redis, RabbitMQ and the API are published on this address only (the frontend stays on the network).
HOST_BIND_IP=127.0.0.1
BACKEND_HOST_PORT=8020
FRONTEND_HOST_PORT=5173
RABBITMQ_HOST_PORT=5673
# RabbitMQ management UI: http://localhost:15673 (user/password below)
RABBITMQ_MANAGEMENT_HOST_PORT=15673

# --- RabbitMQ container (broker of the Celery background jobs) ---
RABBITMQ_USER=menu
RABBITMQ_PASSWORD=menu

# --- Backend settings ---
APP_NAME=Menu SaaS API
ENVIRONMENT=development
# Used when running the API or tests on the host (uv run ...). Inside docker compose,
# DATABASE_URL and REDIS_URL are overridden to point at the postgres/redis services.
# Tests derive their own resources from these: database "<name>_test" and Redis db 15.
# Use 127.0.0.1, not localhost: the services listen on IPv4 only (HOST_BIND_IP) and on Windows "localhost"
# tries IPv6 first, which adds about 2 s to every connection.
DATABASE_URL=postgresql+asyncpg://menu:menu@127.0.0.1:5440/menu
# --- Redis container: required password (also put it in REDIS_URL for runs on the host) ---
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6380/0

# --- Auth ---
# Access token signing key (HS256), at least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# Keep true: browsers accept Secure cookies on http://localhost. Set false only for other plain-HTTP hosts.
AUTH_COOKIE_SECURE=true
# Failed logins allowed per window before a temporary block: per device (client IP + account), and a
# higher backstop per account for all addresses together.
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_CLIENT=5
LOGIN_MAX_FAILURES_BACKSTOP=50
# Proxies whose X-Forwarded-For uvicorn trusts for the client IP (comma-separated IPs or CIDRs).
# docker compose sets it to the frontend container; never "*" while the API port is reachable directly.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Docker network of compose and the frontend's fixed address in it (change both together).
# COMPOSE_SUBNET=10.213.57.0/24
# FRONTEND_IP=10.213.57.10

# --- Images (Cloudinary) ---
# Dashboard > Settings > API Keys. Leave empty to run without image uploads (the API answers 503
# on the upload signature). The secret only signs uploads on the backend; it never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Background jobs (Celery + RabbitMQ, see app/worker.py) ---
# Used on the host (uv run ...); inside docker compose it points at the rabbitmq service.
# Tests ignore it and use an in-process broker (memory://).
CELERY_BROKER_URL=amqp://menu:menu@127.0.0.1:5673//
# A signed image upload never attached to an item is deleted from Cloudinary after this many minutes.
IMAGE_PENDING_TTL_MINUTES=60
# Celery beat runs the image cleanup this often (it also runs right after each image change).
IMAGE_CLEANUP_INTERVAL_SECONDS=300
